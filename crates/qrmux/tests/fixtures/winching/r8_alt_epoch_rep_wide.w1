# Round 8: cross-mode alt epoch, wide-orphan repair, and REP.

case mixed_47_entry_1049_exit_rejects_old_decsc_token
size 5 2 100
emit 10
print ABCDE
decsc
print F
alt-47-enter
alt-1049-exit
print Z
expect 0 1 ABCDE|Z
end

case alt_restore_horizontal_shrink_repairs_wide_orphan
size 5 2 100
emit 10
print abc界F
alt-1049-enter
resize 4 2
alt-1049-exit
expect 0 1 abc|F
end

case rep_one_fires_deferred_wrap
size 5 2 100
