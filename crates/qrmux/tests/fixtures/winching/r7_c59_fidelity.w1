# Round-7 c59-fidelity counterexamples and guarded-write controls.

case accepted_decstbm_home_severs_target_stream
size 5 1 100
emit 10
print ABCDEF
region 1 1
print G
expect 0 1 ABCDE|G
end

case invalid_decstbm_is_noop_and_preserves_stream
size 5 1 100
emit 10
print ABCDEF
region 2 1
print G
expect 1 0 ABCDEFG
end

case combining_mark_17_is_noop_and_preserves_edge
size 5 2 100
emit 10
print ABCD
combine ́
combine ́
combine ́
combine ́
combine ́
combine ́
combine ́
combine ́
combine ́
combine ́
combine ́
combine ́
combine ́
combine ́
combine ́
combine ́
print EF
cup 1 5
combine ́
expect 1 0 ABCD́́́́́́́́́́́́́́́́EF
end

case severed_wide_early_padding_is_real_styled_content
size 5 2 100
emit 10
style blue-bg
print abcd界
style default
cup 1 1
print X
expect 0 1 Xbcd<space>|界
end

case get_history_during_alt_has_hard_main_alt_boundary
size 5 1 100
emit 10
surface get-history
print ABC
lf
alt-enter
print DEF
expect 0 0 ABC|DEF
end

