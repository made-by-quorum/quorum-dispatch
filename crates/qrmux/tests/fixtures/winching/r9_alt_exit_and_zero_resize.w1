# Round 9: all 3x3 alt entry/exit mode combinations and raw zero-height resize.
# Only a 1049 entry followed by a 1049 exit restores the saved main cursor and
# qualified pending token. Every 47/1047 exit keeps the active alt cursor.

case alt_47h_47l_keeps_active_cursor
size 5 2 100
emit 10
print ABCDE
alt-47-enter
print X
alt-47-exit
print Z
expect 0 0 AZCDE
end

case alt_47h_1047l_keeps_active_cursor
size 5 2 100
