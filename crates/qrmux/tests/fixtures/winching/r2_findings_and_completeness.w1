case live_horizontal_resize_severs
size 5 3 100
emit 10
print ABCDEF
resize 3 3
expect 0 1 ABC|F
end

case vertical_resize_boundary_migration_survives
size 5 2 100
emit 10
print ABCDEF
lf
resize 5 3
expect 1 0 ABCDEF
end

case source_print_rewrite_severs
size 5 3 100
emit 10
print ABCDEF
cup 1 1
print Z
expect 0 1 ZBCDE|F
end

case target_cup_write_severs
size 5 3 100
emit 10
print ABCDEF
