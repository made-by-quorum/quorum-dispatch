print Z
expect 0 1 ABCDE|Z
end

case construction_forward_stream_preserves_a16
size 5 3 100
emit 10
print ABCDEF
print G
print H
expect 1 0 ABCDEFGH
end

# Round-3 ordinary CSI cursor-motion setter coverage. Each setter is an
# explicit reposition (including a clamp/no-op) and cancels A2 authorization.
case csi_a_target_stream_reposition_severs
size 5 2 100
emit 10
print ABCDEF
csi-a 1
print Z
expect 0 1 AZCDE|F
end

