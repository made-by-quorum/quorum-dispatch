# Round-2 closure and systematic named-surface completeness cases.

case decawm_off_preserves_existing_edge
size 5 3 100
emit 10
print ABCDEF
decawm off
print G
expect 1 0 ABCDEFG
end

case il_inside_region_cuts_edge
size 5 4 100
emit 10
cup 2 1
print ABCDEF
region 2 3
cup 2 1
insert-lines 1
expect 0 1 ||ABCDE
end

case il_outside_region_is_noop
size 5 4 100
emit 10
cup 3 1
print ABCDEF
region 2 3
insert-lines 1
expect 1 0 ||ABCDEF
end

case dl_inside_region_cuts_edge
size 5 4 100
emit 10
cup 2 1
print ABCDEF
region 2 3
cup 2 1
delete-lines 1
expect 0 1 |F
end

case dl_outside_region_is_noop
size 5 4 100
emit 10
cup 3 1
print ABCDEF
region 2 3
delete-lines 1
expect 1 0 ||ABCDEF
end

case decsc_decrc_saved_pending_cannot_rearm
size 5 3 100
emit 10
print ABCDE
decsc
print F
decrc
print Z
expect 0 1 ABCDE|Z
end

case csi_s_u_saved_pending_cannot_rearm
size 5 3 100
emit 10
print ABCDE
csi-save
print F
csi-restore
print Z
expect 0 1 ABCDE|Z
end

case mode_1048_saved_pending_cannot_rearm
size 5 3 100
emit 10
print ABCDE
1048-save
print F
1048-restore
print Z
expect 0 1 ABCDE|Z
end

case backspace_target_overwrite_severs
size 5 3 100
emit 10
print ABCDEF
bs
print Z
expect 0 1 ABCDE|Z
end

case horizontal_tab_target_overwrite_severs
size 10 3 100
emit 20
print ABCDEFGHIJK
ht
print Z
expect 0 1 ABCDEFGHIJ|K<space><space><space><space><space><space><space>Z
end

case csi_scroll_down_cut_severs
size 5 4 100
emit 10
cup 3 1
print ABCDEF
region 2 4
scroll-down 1
expect 0 1 |||ABCDE
end

case csi_scroll_down_co_move_survives
size 5 4 100
emit 10
cup 2 1
print ABCDEF
region 2 4
scroll-down 1
expect 1 0 ||ABCDEF
end

case lf_at_margin_region_cut_severs
