# Round 15: shrink-chop ignores style but treats combining data as content.

case r15_combining_bottom_row_migrates_not_chopped
size 5 3 100
emit 5
cup 2 1
print <space><space><space><space><space><space>
combine ́
cup 2 2
resize 5 2
expect 1 0 |<space><space><space><space><space><space>́
end

case r15_plain_space_bottom_row_is_chopped
size 5 3 0
emit 5
print ABCDEF
cup 2 1
resize 5 2
expect 1 0 ABCDEF
end

case r15_styled_blank_bottom_row_is_chopped
size 5 3 0
emit 5
print ABCDEF
style blue-bg
cup 3 1
erase-line
cup 2 1
resize 5 2
expect 1 0 ABCDEF
end
