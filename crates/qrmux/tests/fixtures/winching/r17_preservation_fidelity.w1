# Round-17 false-break closures and preservation-half controls.

case wide_early_direct_bce_write_preserves_sparse_combining
size 5 2 100
emit 10
print ABCDE
combine ́
csi-c 1
print 界
expect 1 0 ABCD界
end

case direct_insert_row_below_edge_preserves
size 5 4 100
emit 10
print ABCDEF
insert-row 4
print G
expect 1 0 ABCDEFG
end

case direct_remove_row_below_edge_preserves
size 5 4 100
emit 10
print ABCDEF
remove-row 4
print G
expect 1 0 ABCDEFG
end

case vertical_grow_preserves_pending_construction
size 5 2 100
emit 10
print ABCDE
resize 5 3
print F
expect 1 0 ABCDEF
end

case nonendpoint_cell_operations_preserve_edge
size 5 4 100
emit 10
print ABCDEF
cup 4 1
style blue-bg
print Z
erase-line
ech 1
dch 1
ich 1
style default
expect 1 0 ABCDEF||<space><space><space><space><space>
end

case visible_edge_survives_nonendpoint_ed_and_history_clear
